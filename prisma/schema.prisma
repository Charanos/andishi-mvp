// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                     String           @id @default(auto()) @map("_id") @db.ObjectId
  email                  String           @unique
  name                   String?
  firstName              String
  lastName               String
  password               String?
  passwordLastChanged    DateTime?
  loginAttempts          Int              @default(0)
  accountLocked          Boolean          @default(false)
  role                   String           @default("developer")
  status                 String           @default("pending")
  developerProfileStatus String           @default("pending") // pending, approved, rejected - synced with DeveloperProfile.status
  isActive               Boolean          @default(true)
  accountCreated         Boolean          @default(false)
  passwordGenerated      Boolean          @default(false)
  projectCount           Int              @default(0)
  progress               Int              @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  developerProfile       DeveloperProfile? @relation("UserProfile")
}

model DeveloperProfile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  data            Json
  userId          String?  @unique @db.ObjectId
  user            User?    @relation("UserProfile", fields: [userId], references: [id])
  status          String   @default("pending") // pending, approved, rejected
  isAvailable     Boolean  @default(false)
  busyUntilDate   DateTime? // Date until which developer is considered busy even after project completion
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  assignments     ProjectAssignment[]
}

type Milestone {
  id           String
  title        String
  description  String?
  budget       Float
  timeline     String?
  status       String    @default("pending")
  dueDate      DateTime?
  order        Int
  deliverables String[]
  completedAt  DateTime?
}

type Pricing {
    type String
    currency String
    fixedBudget Float?
    hourlyRate Float?
    estimatedHours Int?
    milestones Milestone[]  // Added for milestone-based pricing
}

type ProjectFile {
  id String
  fileName String
  fileUrl String
  fileSize Float?
  fileType String?
  createdAt DateTime
  updatedAt DateTime?
}

type ProjectPayment {
  id String
  amount Float
  date DateTime
  method String
  status String
  submittedBy String
  notes String?
  description String?
  currency String?
  invoiceUrl String?
  createdAt DateTime?
  updatedAt DateTime?
}

type ProjectUpdate {
  id String
  title String
  description String
  type String
  author String?
  createdAt DateTime
}

model Project {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  title                  String
  description            String?
  status                 String   @default("pending")
  priority               String   @default("medium")
  budget                 Float    @default(0)
  timeline               String?
  techStack              String[]
  requiredSkills         String[]
  experienceLevel        String   @default("Mid-level")
  maxTeamSize            Int      @default(1)
  clientId               String?  @db.ObjectId
  estimatedCompletionDate DateTime?
  actualCompletionDate   DateTime?  // Added for analytics
  currency               String?    @default("USD")  // Added for legacy support
  userInfo               Json?      // Added for legacy client info
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  assignments            ProjectAssignment[]
  milestones             Milestone[]
  pricing                Pricing?
  files                  ProjectFile[]
  payments               ProjectPayment[]
  updates                ProjectUpdate[]
  progress               Int      @default(0)
}

model ProjectAssignment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  developerId String   @db.ObjectId
  role        String   @default("Developer")
  status      String   @default("pending") // pending, accepted, rejected, completed
  assignedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  developer   DeveloperProfile? @relation(fields: [developerId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, developerId])
}

model ProjectChat {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId    String
  participants ChatParticipant[]
  messages     ChatMessage[]
  lastActivity DateTime
}

model ChatParticipant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  chatId    String  @db.ObjectId
  userId    String
  name      String
  role      String
  isOnline  Boolean
  lastSeen  DateTime?
  chat      ProjectChat @relation(fields: [chatId], references: [id])
}

model ChatMessage {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  chatId            String     @db.ObjectId
  senderId          String
  senderName        String
  senderRole        String
  content           String
  timestamp         DateTime   @default(now())
  isRead            Boolean    @default(false)
  chat              ProjectChat @relation(fields: [chatId], references: [id])
  replyToMessageId  String?    @db.ObjectId
  replyToMessage    ChatMessage? @relation("ReplyTo", fields: [replyToMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies           ChatMessage[] @relation("ReplyTo")
}

model Developer {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  email             String
  firstName         String?
  lastName          String?
  personalInfo      Json?
  professionalInfo  Json?
  technicalSkills   Json?
  workExperience    Json?
  projects          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
