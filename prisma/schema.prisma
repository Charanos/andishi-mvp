// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                     String            @id @default(auto()) @map("_id") @db.ObjectId
  email                  String            @unique
  name                   String?
  firstName              String
  lastName               String
  password               String?
  passwordLastChanged    DateTime?
  loginAttempts          Int               @default(0)
  accountLocked          Boolean           @default(false)
  role                   String            @default("developer")
  status                 String            @default("pending")
  developerProfileStatus String            @default("pending") // pending, approved, rejected - synced with DeveloperProfile.status
  isActive               Boolean           @default(true)
  accountCreated         Boolean           @default(false)
  passwordGenerated      Boolean           @default(false)
  projectCount           Int               @default(0)
  progress               Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  developerProfile       DeveloperProfile? @relation("UserProfile")
  company                String?
  phone                  String?
  blogLikes              BlogLike[]
  blogBookmarks          BlogBookmark[]
  blogComments           BlogComment[]
  commentLikes           CommentLike[]
  commentReplies         CommentReply[]
}

model DeveloperProfile {
  id                 String                @id @default(auto()) @map("_id") @db.ObjectId
  data               Json
  userId             String?               @unique @db.ObjectId
  user               User?                 @relation("UserProfile", fields: [userId], references: [id])
  status             String                @default("pending") // pending, approved, rejected
  isAvailable        Boolean               @default(false)
  busyUntilDate      DateTime? // Date until which developer is considered busy even after project completion
  techPoolMember     Boolean               @default(false)
  poolJoinedDate     DateTime?
  lastAssessmentDate DateTime?
  assessmentScore    Float?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  assignments        ProjectAssignment[]
  assessments        DeveloperAssessment[]
  technicalAssessments TechnicalAssessment[]
  evaluationSessions EvaluationSession[]

  @@index([techPoolMember])
}

model DeveloperAssessment {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  developerId          String           @db.ObjectId
  developer            DeveloperProfile @relation(fields: [developerId], references: [id])
  evaluationType       String // initial, periodic, project_based
  technicalSkills      Json // Contains specialty, primaryStack, skillRatings, overallTechnicalScore
  professionalSkills   Json // Contains communication, teamwork, problemSolving, etc.
  experienceAssessment Json // Contains relevantExperience, projectComplexity, industryKnowledge, portfolioQuality
  evaluation           Json // Contains overallScore, recommendation, techPoolEligible, strengths, improvements, etc.
  status               String           @default("draft") // draft, submitted, reviewed, finalized
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  reviewedAt           DateTime?
  expiresAt            DateTime?

  @@index([developerId])
  @@index([status])
}

model TechnicalAssessment {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  developerId       String   @db.ObjectId
  developer         DeveloperProfile @relation(fields: [developerId], references: [id])
  assessmentType    String   // coding_challenge, system_design, specialty_test
  specialty         String   // frontend, backend, fullstack, mobile, devops
  challengeId       String   @db.ObjectId // Reference to AssessmentChallenge
  difficulty        String   // junior, mid, senior, lead
  timeLimit         Int      // minutes
  status            String   @default("pending") // pending, in_progress, completed, expired
  score             Float?
  maxScore          Float?
  aiAnalysis        Json?    // AI evaluation results
  completedAt       DateTime?
  submittedCode     Json?    // Code submissions with language
  testResults       Json?    // Automated test case results
  executionResults  Json?    // Code execution metrics
  securityScan      Json?    // Security analysis results
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  expiresAt         DateTime

  @@index([developerId])
  @@index([status])
  @@index([specialty])
}

model AssessmentChallenge {
  id                 String @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String
  specialty          String // frontend, backend, fullstack, mobile
  difficulty         String // junior, mid, senior, lead
  type               String // coding, system_design, debugging, optimization
  
  // Challenge content
  problemStatement   String
  starterCode        Json   // Language-specific starter templates
  testCases          Json   // Input/output test cases
  constraints        Json   // Time/memory limits
  
  // AI evaluation criteria
  evaluationCriteria Json
  sampleSolutions    Json
  aiPrompts          Json   // Custom prompts for AI evaluation
  
  // Metadata
  timeLimit          Int
  maxAttempts        Int
  tags               String[]
  createdBy          String
  isActive           Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([specialty])
  @@index([difficulty])
  @@index([isActive])
}

model EvaluationSession {
  id                    String @id @default(auto()) @map("_id") @db.ObjectId
  developerId           String @db.ObjectId
  developer             DeveloperProfile @relation(fields: [developerId], references: [id])
  sessionToken          String @unique
  technicalAssessments  String[] @db.ObjectId // References to TechnicalAssessment
  referenceEvaluations  String[] @db.ObjectId // References to current DeveloperAssessment
  portfolioReview       Json?
  overallScore          Float?
  recommendation        String? // approved, rejected, needs_review, probation
  status                String @default("pending") // pending, in_progress, completed
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime @default(now())
  expiresAt             DateTime

  @@index([status])
}

type Milestone {
  id           String
  title        String
  description  String?
  budget       Float
  timeline     String?
  status       String    @default("pending")
  dueDate      DateTime?
  order        Int
  deliverables String[]
  completedAt  DateTime?
}

type Pricing {
  type           String
  currency       String
  fixedBudget    Float?
  hourlyRate     Float?
  estimatedHours Int?
  milestones     Milestone[] // Added for milestone-based pricing
}

type ProjectFile {
  id        String
  fileName  String
  fileUrl   String
  fileSize  Float?
  fileType  String?
  createdAt DateTime
  updatedAt DateTime?
}

type ProjectPayment {
  id          String
  amount      Float
  date        DateTime
  method      String
  status      String
  submittedBy String
  notes       String?
  description String?
  currency    String?
  invoiceUrl  String?
  createdAt   DateTime?
  updatedAt   DateTime?
}

type ProjectUpdate {
  id          String
  title       String
  description String
  type        String
  author      String?
  createdAt   DateTime
}

model Project {
  id                      String              @id @default(auto()) @map("_id") @db.ObjectId
  projectDetails          Json? // Contains title, description, category, techStack, requirements, timeline, priority
  status                  String              @default("pending")
  priority                String              @default("medium")
  budget                  Float               @default(0)
  timeline                String?
  featured                Boolean             @default(false)
  mainFeatured            Boolean             @default(false)
  techStack               String[]
  requiredSkills          String[]
  experienceLevel         String              @default("Mid-level")
  maxTeamSize             Int                 @default(1)
  clientId                String?             @db.ObjectId
  estimatedCompletionDate DateTime?
  actualCompletionDate    DateTime? // Added for analytics
  currency                String?             @default("USD") // Added for legacy support
  userInfo                Json? // Added for legacy client info
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  assignments             ProjectAssignment[]
  milestones              Milestone[]
  pricing                 Pricing?
  files                   ProjectFile[]
  payments                ProjectPayment[]
  updates                 ProjectUpdate[]
  progress                Int                 @default(0)
}

model ProjectAssignment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  developerId String   @db.ObjectId
  role        String   @default("Developer")
  status      String   @default("pending") // pending, accepted, rejected, completed
  assignedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  developer DeveloperProfile? @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([projectId, developerId])
}

model ProjectChat {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  projectId    String            @unique
  participants ChatParticipant[]
  messages     ChatMessage[]
  lastActivity DateTime
}

model ChatParticipant {
  id       String      @id @default(auto()) @map("_id") @db.ObjectId
  chatId   String      @db.ObjectId
  userId   String
  name     String
  role     String
  isOnline Boolean
  lastSeen DateTime?
  chat     ProjectChat @relation(fields: [chatId], references: [id])
}

model ChatMessage {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  chatId           String        @db.ObjectId
  senderId         String
  senderName       String
  senderRole       String
  content          String
  timestamp        DateTime      @default(now())
  isRead           Boolean       @default(false)
  chat             ProjectChat   @relation(fields: [chatId], references: [id])
  replyToMessageId String?       @db.ObjectId
  replyToMessage   ChatMessage?  @relation("ReplyTo", fields: [replyToMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies          ChatMessage[] @relation("ReplyTo")
}

model Developer {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  email            String
  firstName        String?
  lastName         String?
  personalInfo     Json?
  professionalInfo Json?
  technicalSkills  Json?
  workExperience   Json?
  projects         Json?
  cvUrl            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Blog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  author    String
  date      String
  readTime  String
  category  String
  image     String?
  authorImage String?
  views     Int      @default(0)
  likes     Int      @default(0)
  featured  Boolean  @default(false)
  mainFeatured Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogLikes    BlogLike[]
  blogBookmarks BlogBookmark[]
  blogComments  BlogComment[]
}

model BlogLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  blogId    String   @db.ObjectId
  userId    String?  @db.ObjectId
  guestName String?
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([blogId, userId])
  @@unique([blogId, guestName])
}

model BlogBookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  blogId    String   @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([blogId, userId])
}

model BlogComment {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  blogId    String         @db.ObjectId
  userId    String?        @db.ObjectId
  guestName String?
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  blog      Blog           @relation(fields: [blogId], references: [id])
  user      User?          @relation(fields: [userId], references: [id])
  likes     CommentLike[]  @relation("CommentLikes")
  replies   CommentReply[] @relation("CommentReplies")
}

model CommentLike {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  commentId String      @db.ObjectId
  userId    String?     @db.ObjectId
  guestName String?
  createdAt DateTime    @default(now())
  comment   BlogComment @relation("CommentLikes", fields: [commentId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@unique([commentId, guestName])
}

model CommentReply {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  commentId String      @db.ObjectId
  userId    String?     @db.ObjectId
  guestName String?
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  comment   BlogComment @relation("CommentReplies", fields: [commentId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  position   String
  avatar     String?
  rating     Int
  review     String
  project    String
  featured   Boolean  @default(false)
  timeToHire String?
  keyResult  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactFeedback {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageProject {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  category      String
  image         String
  projectImages String[]
  technologies  String[]
  gradient      String   @default("from-gray-500/20 to-gray-600/10")
  liveUrl       String?
  githubUrl     String?
  slug          String?  @unique
  client        String?
  duration      String?
  teamSize      String?
  featured      Boolean  @default(false)
  status        String   @default("planning")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
